{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "//": "lib 진입점과 연결된 agent/src 의존성을 타입체크한다. runtime.ts/cli.ts 는 tsx 실행 진입점이라 직접 포함하지 않는다.",
  "include": ["lib/**/*.ts"]
}
